# Copy to .env (never committed). Values below are placeholders for local development only;
# anything containing "change-me" is rejected when NODE_ENV=production.

NODE_ENV=development
LOG_LEVEL=info
# mock | db — mocks stay available until the end of step 4.
DATA_SOURCE=mock

DATABASE_URL=postgresql://manga:manga_dev_password@localhost:5434/manga
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-48
APP_URL=http://localhost:3000

EMAIL_PROVIDER=brevo
BREVO_API_KEY=change-me
BREVO_WEBHOOK_SECRET=change-me
EMAIL_FROM_TRANSACTIONAL="Manga Performance <no-reply@example.com>"
EMAIL_FROM_MARKETING="Manga Performance <news@example.com>"

S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=manga-performance
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

TURNSTILE_SECRET_KEY=change-me
INTERNAL_API_TOKEN=change-me-generate-with-openssl-rand-base64-48
INTERNAL_API_HMAC_SECRET=change-me-generate-with-openssl-rand-base64-48
TRACKING_HMAC_SECRET=change-me-generate-with-openssl-rand-base64-48

ADMIN_NOTIFICATION_EMAIL=admin@example.com
TZ_DISPLAY=Africa/Abidjan

# Integration tests only (never the dev database): created by infra/postgres/init-test-db.sql.
TEST_DATABASE_URL=postgresql://manga:manga_dev_password@localhost:5434/manga_test
