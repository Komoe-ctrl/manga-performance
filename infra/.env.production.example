# Copy to infra/.env.production (never committed) and replace every value.
# Generate secrets with:  openssl rand -base64 48
# The app refuses to start in production if a value still contains "change-me".

APP_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

POSTGRES_PASSWORD=change-me
BETTER_AUTH_SECRET=change-me
INTERNAL_API_TOKEN=change-me
INTERNAL_API_HMAC_SECRET=change-me
TRACKING_HMAC_SECRET=change-me
# Encrypts the database backups. Store a copy OUTSIDE the server: without it a backup is useless.
BACKUP_PASSPHRASE=change-me

BREVO_API_KEY=change-me
BREVO_WEBHOOK_SECRET=change-me
EMAIL_FROM_TRANSACTIONAL="Manga Performance <no-reply@example.com>"
EMAIL_FROM_MARKETING="Manga Performance <news@example.com>"
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# S3-compatible object storage (OVH, Scaleway, Cloudflare R2...). Private bucket.
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=manga-performance
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
# Where public/blog/* is served from (leave empty to use the endpoint and bucket).
S3_PUBLIC_URL=

# Cloudflare Turnstile: real keys (the public test keys are refused in production).
TURNSTILE_SECRET_KEY=change-me
NEXT_PUBLIC_TURNSTILE_SITE_KEY=change-me

# Scraper: comma-separated domains the client has validated. Empty = nothing is collected.
SCRAPER_ALLOWED_DOMAINS=
SCRAPER_USER_AGENT=
