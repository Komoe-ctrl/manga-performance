{
  "name": "@manga/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./queue": "./src/queue.ts",
    "./billing-jobs": "./src/billing-jobs.ts",
    "./marketing": "./src/marketing.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "seed:dev": "tsx prisma/seed-dev.ts"
  },
  "dependencies": {
    "@manga/core": "workspace:*",
    "@manga/emails": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8",
    "pg-boss": "^12.38.1",
    "prisma": "7.10.1",
    "tsx": "^4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "typescript": "^5"
  }
}
