generator client {
  provider        = "prisma-client"
  output          = "../src/generated"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, citext, unaccent]
}

/// ADMIN is Manga Performance; the three CLIENT_* roles belong to a client company (avenant 1, §3).
enum Role {
  ADMIN
  CLIENT_DIRECTION
  CLIENT_CONTRIBUTEUR
  CLIENT_ANALYSTE
}

enum ProspectStatus {
  NOUVEAU
  EN_NEGOCIATION
  CLIENT
  PERDU
}

enum ProspectSource {
  SITE_FORMULAIRE
  CHATBOT
  SCRAPER
  NEWSLETTER
  MANUEL
  RECOMMANDATION
  DEMO
}

enum CompanySize {
  TPE
  PME
  GRANDE_ENTREPRISE
}

enum Need {
  BUSINESS_PLAN
  TABLEAU_DE_BORD
  TRESORERIE
  MAITRISE_COUTS
  AUDIT
  AUTRE
}

enum InteractionType {
  EMAIL
  APPEL
  REUNION
  NOTE
}

enum InvoiceStatus {
  BROUILLON
  EMISE
  PAYEE
  PARTIELLEMENT_PAYEE
  EN_RETARD
  ANNULEE
}

enum PaymentMethod {
  VIREMENT
  CHEQUE
  ESPECES
  MOBILE_MONEY
  AUTRE
}

/// Better Auth tables (user, session, account, verification, twoFactor) plus our own
/// fields on user: role, clientId, and the login lockout counters.
model User {
  id               String             @id @default(cuid(2))
  name             String
  email            String             @unique @db.Citext
  emailVerified    Boolean            @default(false)
  image            String?
  role             Role               @default(CLIENT_DIRECTION)
  clientId         String?
  client           Client?            @relation(fields: [clientId], references: [id])
  twoFactorEnabled Boolean            @default(false)
  failedLoginCount Int                @default(0)
  lockedUntil      DateTime?          @db.Timestamptz(3)
  /// Set when the firm disables a client's access to the portal.
  disabledAt       DateTime?          @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  assignments      EntityAssignment[]

  @@index([clientId])
}

model Session {
  id        String   @id @default(cuid(2))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid(2))
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  scope                 String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

/// One-time tokens (invitation, password reset) live here with a hashed identifier.
model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id @default(cuid(2))
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([secret])
}

/// Storage for rate-limiter-flexible (RateLimiterPostgres): fixed table and column names.
model RateLimit {
  key    String  @id @db.VarChar(255)
  points Int
  expire BigInt?

  @@map("rate_limiter")
}

model Prospect {
  id              String               @id @default(cuid(2))
  companyName     String
  companyNameNorm String // pour le dédoublonnage (index trigram)
  contactName     String?
  email           String?              @db.Citext
  phone           String? // E.164
  sector          String
  city            String?
  size            CompanySize?
  need            Need?
  status          ProspectStatus       @default(NOUVEAU)
  source          ProspectSource
  estimatedValue  Int? // FCFA
  notes           String?
  consentAt       DateTime?            @db.Timestamptz(3) // consentement au traitement (formulaires publics)
  consentSource   String?
  lostReason      String?
  convertedAt     DateTime?            @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?            @db.Timestamptz(3)
  interactions    Interaction[]
  followUps       FollowUp[]
  client          Client?
  enrollments     SequenceEnrollment[]

  @@index([status])
  @@index([sector])
  @@index([email])
  @@index([phone])
  @@index([companyNameNorm(ops: raw("gin_trgm_ops"))], type: Gin, map: "Prospect_companyNameNorm_trgm_idx")
}

model Interaction {
  id         String          @id @default(cuid(2))
  prospectId String
  prospect   Prospect        @relation(fields: [prospectId], references: [id])
  type       InteractionType
  summary    String
  occurredAt DateTime        @db.Timestamptz(3)
  createdBy  String // userId
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  @@index([prospectId, occurredAt])
}

model FollowUp {
  id          String    @id @default(cuid(2))
  prospectId  String
  prospect    Prospect  @relation(fields: [prospectId], references: [id])
  rule        String // "J+7" | "J+15" | "J+30" | "MANUEL"
  dueAt       DateTime  @db.Timestamptz(3)
  doneAt      DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)
  note        String?

  @@index([dueAt, doneAt])
}

model Client {
  id           String          @id @default(cuid(2))
  prospectId   String          @unique
  prospect     Prospect        @relation(fields: [prospectId], references: [id])
  legalName    String
  address      String?
  taxId        String? // NCC (numéro de compte contribuable)
  portalUsers  User[] // utilisateurs des rôles CLIENT_* rattachés
  entities     Entity[]
  products     ClientProduct[]
  invoices     Invoice[]
  deliverables Deliverable[]
  messages     Message[]
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  deletedAt    DateTime?       @db.Timestamptz(3)
}

model Invoice {
  id                String        @id @default(cuid(2))
  number            String?       @unique // attribué à l'émission, jamais en brouillon
  fneNumber         String? // N° FNE saisi après émission sur la plateforme DGI
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id])
  status            InvoiceStatus @default(BROUILLON)
  vatRate           Int           @default(1800) // en points de base : 1800 = 18 %
  totalHt           Int
  totalVat          Int
  totalTtc          Int
  amountPaid        Int           @default(0)
  issuedAt          DateTime?     @db.Timestamptz(3)
  dueAt             DateTime?     @db.Timestamptz(3)
  cancelledAt       DateTime?     @db.Timestamptz(3)
  cancelReason      String?
  creditNoteOfId    String? // avoir lié à une facture d'origine
  remindersSent     Int           @default(0)
  /// Unpaid-invoice reminders can be switched off per invoice.
  remindersDisabled Boolean       @default(false)
  lastReminderAt    DateTime?     @db.Timestamptz(3)
  lines             InvoiceLine[]
  payments          Payment[]
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)

  /// At most one credit note per invoice (a credit note always cancels the whole invoice).
  @@unique([creditNoteOfId])
  @@index([status, dueAt])
}

model InvoiceLine {
  id        String  @id @default(cuid(2))
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  position  Int
  label     String
  quantity  Int // en centièmes si besoin de fractions (ex. 150 = 1,5 jour)
  unitPrice Int // FCFA HT
  total     Int // FCFA HT
}

model Payment {
  id        String        @id @default(cuid(2))
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amount    Int
  method    PaymentMethod
  paidAt    DateTime      @db.Timestamptz(3)
  reference String?
}

/// Numérotation séquentielle sans trou, par année.
model InvoiceCounter {
  year  Int @id
  value Int
}

model Deliverable {
  id          String                @id @default(cuid(2))
  clientId    String
  client      Client                @relation(fields: [clientId], references: [id])
  title       String
  storageKey  String                @unique
  mimeType    String
  sizeBytes   Int
  checksum    String // sha256
  publishedAt DateTime              @default(now()) @db.Timestamptz(3)
  publishedBy String
  downloads   DeliverableDownload[]
}

model DeliverableDownload {
  id            String      @id @default(cuid(2))
  deliverableId String
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id])
  userId        String
  downloadedAt  DateTime    @default(now()) @db.Timestamptz(3)
}

model Message {
  id             String    @id @default(cuid(2))
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])
  authorId       String
  fromRole       Role
  body           String
  attachmentKey  String?
  /// Original file name, shown in the thread and used for the download.
  attachmentName String?
  attachmentMime String?
  attachmentSize Int?
  readAt         DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([clientId, createdAt])
}

model Notification {
  id        String    @id @default(cuid(2))
  userId    String
  type      String // NEW_DELIVERABLE | NEW_MESSAGE | FOLLOW_UP_DUE | ...
  payload   Json
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, readAt])
}

model EmailSequence {
  id          String               @id @default(cuid(2))
  name        String
  trigger     String // NEWSLETTER_SIGNUP | MANUAL
  active      Boolean              @default(false)
  steps       SequenceStep[]
  enrollments SequenceEnrollment[]
}

model SequenceStep {
  id         String        @id @default(cuid(2))
  sequenceId String
  sequence   EmailSequence @relation(fields: [sequenceId], references: [id])
  order      Int
  delayDays  Int
  subject    String
  bodyJson   Json // contenu éditeur, rendu via React Email

  @@unique([sequenceId, order])
}

model SequenceEnrollment {
  id          String        @id @default(cuid(2))
  sequenceId  String
  sequence    EmailSequence @relation(fields: [sequenceId], references: [id])
  prospectId  String
  prospect    Prospect      @relation(fields: [prospectId], references: [id])
  currentStep Int           @default(0)
  status      String // ACTIVE | COMPLETED | STOPPED | UNSUBSCRIBED | BOUNCED
  nextSendAt  DateTime?     @db.Timestamptz(3)
  enrolledAt  DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([sequenceId, prospectId])
  @@index([status, nextSendAt])
}

model EmailEvent {
  id           String   @id @default(cuid(2))
  messageId    String // id fournisseur
  enrollmentId String?
  email        String   @db.Citext
  type         String // SENT | DELIVERED | OPENED | CLICKED | BOUNCED | COMPLAINED | UNSUBSCRIBED
  occurredAt   DateTime @db.Timestamptz(3)
  meta         Json?

  @@index([enrollmentId])
  @@index([messageId])
  @@index([email, type])
}

/// Liste d'exclusion globale : jamais d'envoi marketing.
model Suppression {
  email     String   @id @db.Citext
  reason    String // UNSUBSCRIBED | HARD_BOUNCE | COMPLAINT | MANUAL
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model NewsletterSubscriber {
  id               String    @id @default(cuid(2))
  email            String    @unique @db.Citext
  confirmTokenHash String?
  confirmExpiresAt DateTime? @db.Timestamptz(3)
  confirmedAt      DateTime? @db.Timestamptz(3)
  unsubscribedAt   DateTime? @db.Timestamptz(3)
  consentIp        String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
}

model BlogPost {
  id              String    @id @default(cuid(2))
  slug            String    @unique
  title           String
  excerpt         String
  category        String
  contentJson     Json // JSON TipTap (source de vérité)
  contentHtml     String // HTML assaini, généré à l'enregistrement
  coverKey        String?
  status          String // DRAFT | PUBLISHED
  publishedAt     DateTime? @db.Timestamptz(3)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)

  @@index([status, publishedAt])
}

model ScrapeJob {
  id           String         @id @default(cuid(2))
  source       String // ANNUAIRE | APPELS_OFFRES | SITE_WEB
  filters      Json
  status       String // QUEUED | RUNNING | DONE | FAILED
  startedAt    DateTime?      @db.Timestamptz(3)
  finishedAt   DateTime?      @db.Timestamptz(3)
  resultsCount Int            @default(0)
  error        String?
  createdBy    String
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  results      ScrapeResult[]

  @@index([status, createdAt])
}

model ScrapeResult {
  id                    String    @id @default(cuid(2))
  jobId                 String
  job                   ScrapeJob @relation(fields: [jobId], references: [id])
  companyName           String
  companyNameNorm       String
  sector                String?
  city                  String?
  address               String?
  phone                 String?
  email                 String?   @db.Citext
  sourceUrl             String
  collectedAt           DateTime  @db.Timestamptz(3)
  duplicateOfProspectId String?
  importedProspectId    String?

  @@index([jobId])
  @@index([companyNameNorm(ops: raw("gin_trgm_ops"))], type: Gin, map: "ScrapeResult_companyNameNorm_trgm_idx")
}

/// Paramètres du cabinet (clé/valeur typée par zod).
model Setting {
  key   String @id
  value Json
}

model AuditLog {
  id        String   @id @default(cuid(2))
  actorId   String?
  action    String
  entity    String
  entityId  String
  diff      Json?
  ip        String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Module Collecte & suivi des dépôts (avenant n°1, §9)
// ---------------------------------------------------------------------------

enum Sector {
  BTP
  HOTELLERIE
  RESTAURATION
  COMMERCE
  TECH_FINTECH
}

enum CollectionFrequency {
  HEBDOMADAIRE
  MENSUELLE
}

enum PeriodStatus {
  A_VENIR
  ATTENDU
  EN_RETARD
  EN_CONTROLE
  REJETE
  VALIDE
  ACCEPTE_AVEC_RESERVE
}

enum SubmissionStatus {
  EN_CONTROLE
  REJETE
  VALIDE
  ACCEPTE_AVEC_RESERVE
  ERREUR_TECHNIQUE
}

/// Filiale, site, hôtel, restaurant, chantier… d'un client : l'unité de cloisonnement du module.
model Entity {
  id           String              @id @default(cuid(2))
  clientId     String
  client       Client              @relation(fields: [clientId], references: [id])
  name         String
  sector       Sector
  currency     String              @default("XOF")
  active       Boolean             @default(true)
  assignments  EntityAssignment[]
  plans        CollectionPlan[]
  cpraNorms    CpraNorm[]
  cpraSettings EntityCpraSetting[]
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([clientId, name])
}

/// Contributeur affecté à une entité : il ne voit que celles-ci.
model EntityAssignment {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([userId, entityId])
  @@index([entityId])
}

model CollectionPlan {
  id         String              @id @default(cuid(2))
  entityId   String
  entity     Entity              @relation(fields: [entityId], references: [id])
  templateId String // ex. "hotel_mensuel"
  frequency  CollectionFrequency @default(MENSUELLE)
  delayDays  Int                 @default(3)
  startsOn   DateTime            @db.Timestamptz(3)
  active     Boolean             @default(true)
  periods    CollectionPeriod[]

  @@unique([entityId, templateId])
}

model CollectionPeriod {
  id              String           @id @default(cuid(2))
  planId          String
  plan            CollectionPlan   @relation(fields: [planId], references: [id])
  periodStart     DateTime         @db.Timestamptz(3)
  periodEnd       DateTime         @db.Timestamptz(3)
  dueAt           DateTime         @db.Timestamptz(3)
  status          PeriodStatus     @default(ATTENDU)
  remindersSent   Int              @default(0)
  lastReminderAt  DateTime?        @db.Timestamptz(3)
  submissions     Submission[]
  cpraResults     CpraResult[]
  hotelKpiResults HotelKpiResult[]

  @@unique([planId, periodStart])
  @@index([status, dueAt])
}

model Submission {
  id              String           @id @default(cuid(2))
  periodId        String
  period          CollectionPeriod @relation(fields: [periodId], references: [id])
  version         Int
  templateId      String
  templateVersion Int
  storageKey      String           @unique
  originalName    String
  sizeBytes       Int
  checksum        String // sha256
  uploadedBy      String // userId
  uploadedAt      DateTime         @default(now()) @db.Timestamptz(3)
  status          SubmissionStatus @default(EN_CONTROLE)
  /// { errors: [...], warnings: [...] }
  report          Json?
  /// Lignes normalisées (préparation de l'option 3, aucun KPI calculé ici).
  rows            Json?
  rowCount        Int?
  /// Forçage admin : commentaire obligatoire.
  reviewComment   String?
  reviewedBy      String?

  cpraResults     CpraResult[]
  hotelKpiResults HotelKpiResult[]

  @@unique([periodId, version])
}

// ---------------------------------------------------------------------------
// Pilote hôtellerie : paramètres CPRA et résultats (avenant n°1, v1.1)
// Quantités et coûts unitaires en Decimal (jamais Float) ; l'arrondi au FCFA ne se fait que sur l'écart valorisé.
// ---------------------------------------------------------------------------

/// Catalogue des consommables suivis pour un client.
model ClientProduct {
  id            String              @id @default(cuid(2))
  clientId      String
  client        Client              @relation(fields: [clientId], references: [id])
  code          String
  label         String
  /// Unité de calcul CPRA : "unite" ou "ml".
  referenceUnit String
  active        Boolean             @default(true)
  conversions   ProductConversion[]
  norms         CpraNorm[]
  results       CpraResult[]

  @@unique([clientId, code])
  @@unique([clientId, label])
}

/// Unité de livraison -> unité de référence. `factor` nul = unité déclarée mais facteur inconnu (« conversion manquante »).
model ProductConversion {
  id           String        @id @default(cuid(2))
  productId    String
  product      ClientProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  deliveryUnit String
  factor       Decimal?      @db.Decimal(14, 4)

  @@unique([productId, deliveryUnit])
}

/// Norme par produit, éventuellement propre à une entité ; on applique la dernière `validFrom` <= début de période.
model CpraNorm {
  id            String        @id @default(cuid(2))
  productId     String
  product       ClientProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Nul = norme par défaut du client.
  entityId      String?
  entity        Entity?       @relation(fields: [entityId], references: [id])
  validFrom     DateTime      @db.Timestamptz(3)
  normPerClient Decimal       @db.Decimal(14, 4)
  nonUserRate   Decimal       @default(0) @db.Decimal(5, 4)
  unitCostFcfa  Decimal       @db.Decimal(14, 4)

  @@index([productId, entityId, validFrom])
}

model EntityCpraSetting {
  id             String   @id @default(cuid(2))
  entityId       String
  entity         Entity   @relation(fields: [entityId], references: [id])
  validFrom      DateTime @db.Timestamptz(3)
  longStayFactor Decimal  @db.Decimal(6, 4)

  @@unique([entityId, validFrom])
}

/// Résultat figé d'un calcul, par période x produit. Un recalcul crée une nouvelle version, l'ancienne est conservée.
model CpraResult {
  id             String           @id @default(cuid(2))
  periodId       String
  period         CollectionPeriod @relation(fields: [periodId], references: [id])
  submissionId   String
  submission     Submission       @relation(fields: [submissionId], references: [id])
  productId      String
  product        ClientProduct    @relation(fields: [productId], references: [id])
  cproRef        Decimal?         @db.Decimal(18, 4)
  cpra           Decimal          @db.Decimal(18, 4)
  ecartVolume    Decimal?         @db.Decimal(18, 4)
  couverture     Decimal?         @db.Decimal(8, 4)
  ecartValorise  Int?
  /// CONFORME | SOUS | SOUS_FORTE | SUR | SUR_FORTE | CPRO_MANQUANT | CONVERSION_MANQUANTE | NA
  status         String
  /// Normes, facteurs, coûts et population utilisés : le calcul est reproductible.
  paramsSnapshot Json
  note           String?
  computedBy     String?
  computedAt     DateTime         @default(now()) @db.Timestamptz(3)
  version        Int
  /// Validation du consultant : les résultats ne sont visibles par le client qu'après validation (avenant §10).
  validatedAt    DateTime?        @db.Timestamptz(3)
  validatedBy    String?

  @@unique([periodId, productId, version])
  @@index([submissionId])
  @@index([periodId, version])
}

/// Résultat figé des KPI d'un hôtel pour une période. Un recalcul crée une nouvelle version, l'ancienne est conservée.
model HotelKpiResult {
  id             String           @id @default(cuid(2))
  periodId       String
  period         CollectionPeriod @relation(fields: [periodId], references: [id])
  submissionId   String
  submission     Submission       @relation(fields: [submissionId], references: [id])
  version        Int
  /// `HotelKpis` : chambresDisponibles, gop, revpar, trevpar, goppar, marge, occupation, ADR, OTA.
  kpis           Json
  /// `HotelAlert[]` calculés avec les seuils du client et le mois précédent.
  alerts         Json
  /// KPI du mois précédent utilisés pour `COSTS_OUTPACE`, ou null.
  previous       Json?
  /// Valeurs brutes, jours et libellés manquants : le calcul reste reproductible.
  paramsSnapshot Json
  note           String?
  computedBy     String?
  computedAt     DateTime         @default(now()) @db.Timestamptz(3)
  /// Validation du consultant : les KPI ne sont visibles par le client qu'après validation (avenant §10).
  validatedAt    DateTime?        @db.Timestamptz(3)
  validatedBy    String?

  @@unique([periodId, version])
  @@index([submissionId, version])

// Références clients et témoignages (site public, gérés dans /admin/references)
// ---------------------------------------------------------------------------

/// Un client dont on peut citer le nom. Publiable seulement avec son autorisation (contrainte SQL).
model Reference {
  id                  String        @id @default(cuid(2))
  name                String
  sector              String
  description         String
  /// Logo téléversé sous `public/references/` (PNG ou JPG).
  logoKey             String?
  url                 String?
  displayOrder        Int           @default(0)
  published           Boolean       @default(false)
  /// Le client autorise la citation de son nom et de son logo : obligatoire pour publier.
  clientAuthorization Boolean       @default(false)
  testimonials        Testimonial[]
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?     @db.Timestamptz(3)

  @@index([published, displayOrder])
}

/// Citation d'un client, rattachée à une référence. Publiable seulement avec l'autorisation écrite (contrainte SQL).
model Testimonial {
  id                   String    @id @default(cuid(2))
  quote                String
  author               String
  authorRole           String
  referenceId          String
  reference            Reference @relation(fields: [referenceId], references: [id])
  /// Autorisation écrite de l'auteur de la citation : obligatoire pour publier.
  writtenAuthorization Boolean   @default(false)
  published            Boolean   @default(false)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime? @db.Timestamptz(3)

  @@index([referenceId])
  @@index([published])
}
