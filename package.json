{
  "name": "manga-performance",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @manga/web --filter @manga/worker dev",
    "build": "pnpm --filter @manga/web build",
    "lint": "eslint packages apps/worker && pnpm --filter @manga/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:up": "docker compose -f infra/docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.dev.yml down",
    "db:generate": "pnpm --filter @manga/db generate",
    "db:migrate": "pnpm --filter @manga/db migrate:dev",
    "db:deploy": "pnpm --filter @manga/db migrate:deploy",
    "db:seed": "pnpm --filter @manga/db seed",
    "db:seed:dev": "pnpm --filter @manga/db seed:dev",
    "storage:setup": "pnpm --filter @manga/web storage:setup",
    "e2e": "pnpm --filter @manga/web e2e"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "^5"
  }
}
